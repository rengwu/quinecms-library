{
  "type": "tessera-article",
  "version": 1,
  "label": "Tessera · Article",
  "theme": "Tessera",
  "description": "Editable article section for the Tessera design.",
  "tags": [
    "software",
    "editorial"
  ],
  "kind": "static",
  "framework": "react",
  "activation": "load",
  "component": "View.tsx",
  "fields": [
    {
      "key": "title",
      "label": "Title",
      "type": "text"
    },
    {
      "key": "category",
      "label": "Category",
      "type": "text"
    },
    {
      "key": "summary",
      "label": "Summary",
      "type": "text",
      "multiline": true
    },
    {
      "key": "metadata",
      "label": "Metadata",
      "type": "text"
    },
    {
      "key": "image",
      "label": "Image",
      "type": "media"
    },
    {
      "key": "body",
      "label": "Body",
      "type": "richtext"
    },
    {
      "key": "examples",
      "label": "Examples",
      "type": "richtext"
    },
    {
      "key": "nextLabel",
      "label": "Nextlabel",
      "type": "text"
    },
    {
      "key": "nextURL",
      "label": "Next url",
      "type": "url"
    }
  ],
  "defaults": {
    "title": "Introduction",
    "category": "",
    "summary": "",
    "metadata": "",
    "image": null,
    "body": "",
    "examples": "",
    "nextLabel": "",
    "nextURL": ""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
